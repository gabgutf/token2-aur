[% from "base.j2" import base_package with context %]
[#
	We're compiling with GCC and eventually Rust (LLVM),
	we can't use LTO since their IRs are incompatible.
#]
[[- base_package(
	pkgname		= pkgbase + "-gui",
	pkgdesc		= "Token2 FIDO2 key management GUI with OTP and PIV features.",
	provides	= [ pkgbase + "-gui" ],
	sources		= [ sources.fido2manage, sources.libfido2 ],
	depends		= [
		"gdk-pixbuf2", "cairo", "gtk3", "wayland", "webkit2gtk-4.1", "libsoup3",
		pkgbase + "-lib",
	],
	makedepends	= [ "cmake", "cargo-tauri" ],
	options		= [ "!lto" ]
) -]]

build() {
	# The GUI requires a patched libfido2
	FIDO2_DIR=`find -maxdepth 1 -type d -name "libfido2-*"`
	pushd "${FIDO2_DIR}"
	patch -p1 < "../fido2-manage-${pkgver}/libfido2-token2.patch"

	cmake \
		-S . \
		-B build/ \
		-DBUILD_TOOLS=OFF \
		-DBUILD_EXAMPLES=OFF \
		-DUSE_PCSC=ON \
		-DBUILD_STATIC_LIBS=ON \
		-DBUILD_SHARED_LIBS=OFF
	cmake --build build/ --target fido2
	popd

	export FIDO2_LIB_DIR=`realpath ${FIDO2_DIR}/build/src`
	export FIDO2_LINK_STATIC=1

	pushd "fido2-manage-${pkgver}/token2-piv-gui/src-tauri/"
	# Build system hack for Tauri. Sometimes bundles shared libraries from 'lib/'
	# and outright fails if it's empty.
	mkdir -p libs/
	touch libs/.keep
	RUSTFLAGS="--remap-path-prefix=$srcdir=" cargo build \
		--release \
		--bin token2-key-manager \
		--bin fido2-manage
	popd
}

package() {
	cd "fido2-manage-${pkgver}/token2-piv-gui/src-tauri/"

	pushd "target/release/"
	install -m755 -d "${pkgdir}/usr/bin/"
	install -m755 token2-key-manager fido2-manage "${pkgdir}/usr/bin/"
	popd

	install -m755 -d "${pkgdir}/usr/share/pixmaps/"
	install -m755 -d "${pkgdir}/usr/share/applications/"
	install -Dm644 icons/icon.png "${pkgdir}/usr/share/pixmaps/token2-key-manager.png"

	install -Dm644 /dev/stdin "${pkgdir}/usr/share/applications/token2-key-manager.desktop" <<-EOF
		[Desktop Entry]
		Type=Application
		Version=0.2.0
		Categories=Utility;HardwareSettings;Security;

		Exec=/usr/bin/token2-key-manager
		Icon=token2-key-manager
		Terminal=false

		Name=Token2 Key Manager
		Name[es]=Token2 Key Manager

		Comment=Token2 hardware key management companion app
		Comment[es]=Aplicación de gestión de llaves hardware Token2

		Keywords=Token2;Key;
		Keywords[es]=Token2;Key;Llave;
	EOF
}
